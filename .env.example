NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://loadmaster:loadmaster_dev@localhost:5432/loadmaster
JWT_SECRET=dev-secret-change-in-production-loadmaster-2024
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
# Use a unique, stable random secret of at least 32 characters; retain it for decryption.
PAYER_TAX_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-chars
# Enable only for local development/test. The fixture is never persisted and is blocked in production.
ENABLE_1099_TEST_FIXTURE=false
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STORAGE_TYPE=local
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/tiff
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug
